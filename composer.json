{
    "name": "light-vehikl/bot",
    "description": "Helper for connecting your own Light Vehikl Bot to a game.",
    "homepage": "https://github.com/ElThac0/light-vehikl-bot",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Russell Paddick",
            "email": "r.paddick@vehikl.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel-zero/framework": "12.0.2",
        "light-vehikl/lvobjects": "^0.2@alpha"
    },
    "require-dev": {
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["lvbot"]
}
